# Copia este archivo a .env.local y ajusta los valores.
#   cp .env.example .env.local
# .env.local NO se sube a Git (esta en .gitignore).

# URL base de la API de geocodificacion (Open-Meteo). No requiere clave.
GEOCODING_API_URL=https://geocoding-api.open-meteo.com/v1

# URL base de la API de pronostico (Open-Meteo). No requiere clave.
FORECAST_API_URL=https://api.open-meteo.com/v1

# Clave opcional de Open-Meteo (solo para uso comercial / plan de pago).
# Si la defines, se envia como parametro `apikey` y debes cambiar las dos URLs
# anteriores por las del endpoint "customer-api". Dejala vacia para el plan gratuito.
OPEN_METEO_API_KEY=

# URL publica de la app. Se usa en metadatos (Open Graph). En Vercel pon tu dominio.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
